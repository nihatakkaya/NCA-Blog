Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ohuziiqWrTV_FCvySHumchfR7ZdjRr1V5b6i4F1PlQ4

{
  "title": "Güncellenmiş Blog Başlığı",
  "content": "Bu yazının içeriğini güncelledim.",
  "summary": "Güncellenmiş özet"
}

### BLOG SİL
DELETE {{BlogApi_HostAddress}}/api/post/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ohuziiqWrTV_FCvySHumchfR7ZdjRr1V5b6i4F1PlQ4

### BLOG OLUŞTUR
POST {{BlogApi_HostAddress}}/api/post
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..AeeyT7TxYEX_NZUlWbXmQCu5ZvlOBXIndCy_fUpSz2I


{
  "title": "Test Blog",
  "content": "Yorum test edeceğimiz blog.",
  "summary": "Test"
}

### POSTUN YORUMLARINI GETİR
GET {{BlogApi_HostAddress}}/api/posts/3/comments

### YORUM EKLE
POST {{BlogApi_HostAddress}}/api/posts/3/comments
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..AeeyT7TxYEX_NZUlWbXmQCu5ZvlOBXIndCy_fUpSz2I

{
  "content": "Bu benim ilk yorumum."
}

### YORUM GÜNCELLE
PUT {{BlogApi_HostAddress}}/api/posts/3/comments/1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..AeeyT7TxYEX_NZUlWbXmQCu5ZvlOBXIndCy_fUpSz2I

{
  "content": "Yorumumu güncelledim."
}

### YORUM SİL
DELETE {{BlogApi_HostAddress}}/api/posts/3/comments/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..AeeyT7TxYEX_NZUlWbXmQCu5ZvlOBXIndCy_fUpSz2I

